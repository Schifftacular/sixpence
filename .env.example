# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# development | preview | production. Real-data features (guest email, real documents) only run in production.
APP_ENV=development
# Optional: free Unsplash key (unsplash.com/developers) turns on photo ideas in Explore. Without it, Ideas shows text ideas only.
UNSPLASH_ACCESS_KEY=
# Local development only: shows an email + password sign-in next to Google (ignored in production builds).
NEXT_PUBLIC_DEV_EMAIL_LOGIN=
